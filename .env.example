# Environment Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================================================
# OCR SETTINGS
# ============================================================================
# OCR Engine: "easyocr", "paddleocr", or "hybrid" (recommended)
OCR_ENGINE=hybrid

# Use GPU if available (faster but requires CUDA)
USE_GPU=false

# OCR model cache directory
OCR_CACHE_DIR=.cache/ocr

# Enable preprocessing before OCR
OCR_PREPROCESS=true

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# SQLite database path
DB_PATH=outputs/id_cards.db

# CSV export path
CSV_PATH=outputs/id_cards.csv

# Portrait output directory
PORTRAIT_DIR=outputs/portraits

# Data export directory
DATA_DIR=outputs/data

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# Allowed image formats (comma-separated)
ALLOWED_FORMATS=jpg,jpeg,png,webp

# Strip EXIF metadata for privacy
STRIP_EXIF=true

# ============================================================================
# FACE DETECTION SETTINGS
# ============================================================================
# Minimum confidence threshold (0.0 - 1.0)
MIN_CONFIDENCE=0.6

# Crop margin percentage (0-40)
CROP_MARGIN_PERCENT=10

# Maximum number of faces to process
MAX_FACES=10

# ============================================================================
# COMPARISON SETTINGS
# ============================================================================
# Similarity threshold for "Valid Match" (0.0 - 1.0)
THRESHOLD_VALID=0.95

# Similarity threshold for "Partial Match" (0.0 - 1.0)
THRESHOLD_PARTIAL=0.70

# ============================================================================
# STREAMLIT SETTINGS
# ============================================================================
# Server port
STREAMLIT_SERVER_PORT=8501

# Server address
STREAMLIT_SERVER_ADDRESS=localhost

# Enable/disable logger
STREAMLIT_LOGGER_LEVEL=info

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Debug mode (verbose logging)
DEBUG=false

# Show OCR raw text in UI
SHOW_OCR_TEXT=false

# Show debug metrics in UI
SHOW_DEBUG_METRICS=false
